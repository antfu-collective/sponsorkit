{
  "name": "sponsorkit",
  "type": "module",
  "version": "19.0.0",
  "packageManager": "pnpm@11.18.0",
  "description": "Toolkit for generating sponsors images",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu-collective/sponsorkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu-collective/sponsorkit.git"
  },
  "bugs": {
    "url": "https://github.com/antfu-collective/sponsorkit/issues"
  },
  "keywords": [
    "sponsors",
    "github-sponsors"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "sponsorkit": "./dist/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp"
  },
  "dependencies": {
    "ansis": "^4.4.0",
    "cac": "^7.1.0",
    "consola": "^3.4.2",
    "d3-hierarchy": "^3.1.2",
    "normalize-url": "^10.0.0",
    "ofetch": "^1.5.1",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5",
    "unconfig": "^7.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/ni": "^30.6.0",
    "@antfu/utils": "^9.3.0",
    "@fast-csv/parse": "^5.0.8",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "inlinedDependencies": {
    "@antfu/utils": "9.3.0",
    "@fast-csv/parse": "5.0.8"
  }
}
